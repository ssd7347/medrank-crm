# Copy to .env (git-ignored) for local development, or set these as real environment variables.
DB_URL=jdbc:postgresql://localhost:5432/ai_call_crm
DB_USERNAME=postgres
DB_PASSWORD=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# true in production (HTTPS); false only for local http://localhost.
COOKIE_SECURE=false
# The one admin account, created only when the database has no users yet (the company owner).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
# Minutes-style duration; sessions end after this long without activity (default 3m).
# If you change it, change IDLE_TIMEOUT_MS in frontend/src/lib/use-idle.tsx to match.
SESSION_IDLE_TIMEOUT=3m
# Staff sign in with their mobile number and a one-time code.
# Mobile number of the first admin (the ADMIN_EMAIL account).
ADMIN_PHONE=
# TEMPORARY until WhatsApp/SMS is connected: true shows the code on the login page instead of sending it.
# While true, anyone who knows a staff mobile number can sign in. Never true on a public site.
OTP_SHOW_ON_SCREEN=false
# The modules this customer has bought: ALL, or a comma-separated list of AI_CALLS, IMPORT, EXPORT, FOLLOW_UPS.
# Set by you (the seller); the customer's admin cannot change it. Example for a basic plan: IMPORT,EXPORT
FEATURES=ALL
# AI voice calling agent. Leave VOICE_PLATFORM as "simulated" until a voice-AI platform and a telephony
# provider are connected (docs/voice-agent.md). VOICE_HMAC_SECRET: 32+ random characters shared with the
# platform. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
VOICE_ENABLED=true
VOICE_PLATFORM=simulated
VOICE_HMAC_SECRET=
# Staff desk number for live transfers, e.g. +914412345678. Empty = callbacks only.
VOICE_DESK_NUMBER=
# Our own AI voice. AI_BRAIN: SIMULATED, LOCAL (open model through Ollama) or CLAUDE (needs ANTHROPIC_API_KEY).
AI_BRAIN=SIMULATED
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default: smarter, caches every turn) or claude-haiku-4-5 (fastest, simplest calls).
ANTHROPIC_MODEL=claude-sonnet-5-5
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b
# The speech engine in voice-engine/ (Whisper + Piper). SPEECH_TOKEN must match the engine's when set.
SPEECH_URL=http://localhost:8090
SPEECH_TOKEN=

# Your consultancy's name for receipts and messages.
ORG_NAME=
# Copy to .env (git-ignored) for local development, or set these as real environment variables.
DB_URL=jdbc:postgresql://localhost:5432/mbbs_crm
DB_USERNAME=postgres
DB_PASSWORD=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# true in production (HTTPS); false only for local http://localhost.
COOKIE_SECURE=false
# First super admin, created only when the database has no users yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
# Cloudflare R2 for documents (leave empty in development to store under data/uploads).
# Endpoint looks like https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Minutes-style duration; sessions end after this long without activity (default 3m).
# If you change it, change IDLE_TIMEOUT_MS in frontend/src/lib/use-idle.tsx to match.
SESSION_IDLE_TIMEOUT=3m
